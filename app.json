{
  "expo": {
    "name": "Node Learn",
    "slug": "node-learn",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nodelearn",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.hyperter96.nodelearn",
      "supportsTablet": true,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Node Learn uses your photo library so you can attach images as learning evidence and set a profile photo.",
        "NSCameraUsageDescription": "Node Learn uses the camera so you can capture learning evidence.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hyperter96.nodelearn",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "app.node-learn.com", "pathPrefix": "/auth/oauth-return" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "backgroundColor": "#208AEF", "image": "./assets/images/splash-icon.png", "imageWidth": 76 }],
      ["expo-image-picker", { "photosPermission": "Node Learn uses your photo library so you can attach images as learning evidence and set a profile photo." }]
    ],
    "experiments": { "typedRoutes": true, "reactCompiler": true },
    "extra": { "eas": { "projectId": "" } },
    "runtimeVersion": { "policy": "appversion" }
  }
}
