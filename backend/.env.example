# Copy to backend/.env and fill in. This file is git-ignored; never commit real values.
# Variable names follow E:\proto-store\backend.

# --- Appwrite (server-side, secret) -------------------------------------------
APPWRITE_ENDPOINT=https://sfo.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6ab149e4001d09a18de3
# API key from Console > Project > API Keys. Used for local backend/scripts only;
# Appwrite Functions use the per-execution dynamic x-appwrite-key. Minimum local scopes:
#   users.read, users.write, teams.read, databases.read, tables.read, tables.write,
#   rows.read, rows.write, buckets.read, files.read, files.write, tokens.read, tokens.write
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=main
# Team whose members may call /v1/admin/* (leave empty to disable admin routes).
# Dev project uses team id `admins` (Console > Auth > Teams).
APPWRITE_ADMIN_TEAM_ID=admins
# Bucket holding learner evidence uploads (private by default)
APPWRITE_EVIDENCE_BUCKET_ID=evidence
# Bucket holding public avatar uploads
APPWRITE_AVATAR_BUCKET_ID=avatars
# Bucket holding Q&A question/answer attachments (signed-in members, via short-lived tokens)
APPWRITE_QA_BUCKET_ID=qa

# --- HTTP ---------------------------------------------------------------------
PORT=8070
# Comma-separated allowlist. The Expo web dev server runs on 8071.
CORS_ORIGINS=http://localhost:8071,http://127.0.0.1:8071
RATE_LIMIT_PER_MIN=120
LOG_LEVEL=info

# --- Local development / tests ------------------------------------------------
# development | test | production
NODE_ENV=development
# When set (and NODE_ENV is not production), requests carrying
# `X-Dev-User-Id: <this id>` are treated as that user. NEVER set in production.
API_DEV_BYPASS_USER_ID=
# Deployed API Function (npm run deploy:functions or deploy:api). Point EXPO_PUBLIC_API_BASE_URL here for staging/prod builds.
EXPO_PUBLIC_API_BASE_URL_PROD=https://6ab25202000c575857b2.appwrite.network

# --- Scheduled healthcheck Function ------------------------------------------
HEALTHCHECK_NAME=Node Learn API
HEALTHCHECK_URL=https://6ab25202000c575857b2.appwrite.network/readyz
HEALTHCHECK_TIMEOUT_MS=7000
# Slack/incident webhook URL. Keep out of git; Appwrite var can be managed manually.
ALERT_WEBHOOK_URL=
