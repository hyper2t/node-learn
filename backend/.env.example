# Copy to backend/.env and fill in. This file is git-ignored; never commit real values.
# Variable names follow E:\proto-store\backend.

# --- Appwrite (server-side, secret) -------------------------------------------
APPWRITE_ENDPOINT=https://sfo.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6ab149e4001d09a18de3
# API key from Console > Project > API Keys. Minimum scopes:
#   users.read, users.write, account.read, databases.read, databases.write,
#   storage.read, storage.write, teams.read, tokens.read, tokens.write
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=main
# Team whose members may call /v1/admin/* (leave empty to disable admin routes)
APPWRITE_ADMIN_TEAM_ID=
# Bucket holding learner evidence uploads (private by default)
APPWRITE_EVIDENCE_BUCKET_ID=evidence

# --- HTTP ---------------------------------------------------------------------
PORT=8070
# Comma-separated allowlist. The Expo web dev server runs on 8071.
CORS_ORIGINS=http://localhost:8071,http://127.0.0.1:8071
RATE_LIMIT_PER_MIN=120
LOG_LEVEL=info

# --- Local development / tests ------------------------------------------------
# development | test | production
NODE_ENV=development
# When set (and NODE_ENV is not production), requests carrying
# `X-Dev-User-Id: <this id>` are treated as that user. NEVER set in production.
API_DEV_BYPASS_USER_ID=
