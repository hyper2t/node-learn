{
  "name": "node-learn-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node Learn REST API (v1). Hono core + Node / Appwrite Function adapters, Appwrite TablesDB as the data layer.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts",
    "build:function": "node scripts/build-function.mjs",
    "make-dev-user": "tsx scripts/make-dev-user.ts",
    "tables:ensure": "tsx scripts/ensure-tables.ts",
    "backfill:permissions": "tsx scripts/backfill-permissions.ts",
    "smoke:uploads": "tsx scripts/upload-smoke.ts",
    "schema:check": "tsx scripts/check-schema.ts",
    "push-vars": "node scripts/push-vars.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "deploy:function": "node scripts/build-function.mjs && cd .. && appwrite push function --function-id node-learn-api --force && cd backend && node scripts/verify-deploy.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "hono": "^4.6.14",
    "node-appwrite": "^29.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "vitest": "^2.1.8"
  }
}
