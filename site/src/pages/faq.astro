---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { FAQS, SITE } from '../data/site';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.flatMap((g) =>
    g.items.map((i) => ({
      '@type': 'Question',
      name: i.q,
      acceptedAnswer: { '@type': 'Answer', text: i.a },
    })),
  ),
};
---

<Base
  title="FAQ"
  description="Straight answers about how Node Learn works, how sign-in and accounts behave, what we do and do not verify, and what happens to your data."
>
  <Section
    eyebrow="FAQ"
    title="Straight answers."
    lede="If something here is unclear or you think an answer is evasive, tell us and we will rewrite it."
    narrow
  >
    <div class="space-y-10">
      {
        FAQS.map((group) => (
          <div>
            <h2 class="mb-4 text-caption font-semibold uppercase tracking-wider text-primary">
              {group.category}
            </h2>
            <div class="divide-y divide-border overflow-hidden rounded-lg border border-border bg-surface shadow-card">
              {group.items.map((item) => (
                <details class="group">
                  <summary class="flex cursor-pointer list-none items-start justify-between gap-4 p-5 text-body font-semibold text-foreground [&::-webkit-details-marker]:hidden">
                    <span class="text-pretty">{item.q}</span>
                    <svg
                      class="mt-1 size-4 shrink-0 text-foreground-tertiary transition-transform duration-150 group-open:rotate-45"
                      viewBox="0 0 16 16"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M8 3.5v9M3.5 8h9"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                      />
                    </svg>
                  </summary>
                  <p class="px-5 pb-5 text-small leading-6 text-foreground-secondary">{item.a}</p>
                </details>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-12 rounded-lg border border-border bg-surface p-6 shadow-card">
      <h2 class="text-h3 font-semibold text-foreground">Still have a question?</h2>
      <p class="mt-2 text-small leading-6 text-foreground-secondary">
        Write to <a
          href={`mailto:${SITE.email.hello}`}
          class="rounded-sm text-primary underline underline-offset-2">{SITE.email.hello}</a
        >. For privacy requests use <a
          href={`mailto:${SITE.email.privacy}`}
          class="rounded-sm text-primary underline underline-offset-2">{SITE.email.privacy}</a
        >, and for safety concerns <a
          href={`mailto:${SITE.email.safety}`}
          class="rounded-sm text-primary underline underline-offset-2">{SITE.email.safety}</a
        >.
      </p>
    </div>
  </Section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</Base>

