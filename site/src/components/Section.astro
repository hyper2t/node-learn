---
interface Props {
  eyebrow?: string;
  title?: string;
  lede?: string;
  /** Narrow the text column for long-form reading. */
  narrow?: boolean;
  class?: string;
  id?: string;
}
const { eyebrow, title, lede, narrow = false, class: className = '', id } = Astro.props;
---

<section id={id} class:list={['mx-auto max-w-desktop px-5 py-16 sm:px-8 sm:py-20', className]}>
  {
    (eyebrow || title || lede) && (
      <div class:list={['mb-10', narrow ? 'max-w-2xl' : 'max-w-3xl']}>
        {eyebrow && (
          <p class="mb-3 text-caption font-semibold uppercase tracking-wider text-primary">
            {eyebrow}
          </p>
        )}
        {title && (
          <h2 class="text-balance text-[28px] font-bold leading-[1.2] tracking-[-0.02em] text-foreground sm:text-[32px] sm:leading-10">
            {title}
          </h2>
        )}
        {lede && <p class="mt-4 text-pretty text-[17px] leading-7 text-foreground-secondary">{lede}</p>}
      </div>
    )
  }
  <slot />
</section>

