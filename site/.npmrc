# Appwrite Sites' build sandbox refuses "remote" tarball URLs (EALLOWREMOTE), so the
# lockfile must resolve against the public registry. The machine-level ~/.npmrc here
# points at registry.npmmirror.com, which bakes mirror URLs into package-lock.json and
# breaks the cloud build. Pinning it per-package keeps local installs and cloud builds
# using the same source of truth.
registry=https://registry.npmjs.org/

