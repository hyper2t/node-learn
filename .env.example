# Copy this file to .env and fill in the values from the Appwrite Console.
# EXPO_PUBLIC_ values are bundled into the client app; never put API keys or other secrets here.
# Variable names follow E:\proto-store so tooling and docs stay interchangeable.

# --- Appwrite (client, public) --------------------------------------------------
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://sfo.cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=6ab149e4001d09a18de3
EXPO_PUBLIC_APPWRITE_PROJECT_NAME=Node Learn
# Native platform ID registered in Appwrite Console > Platforms (iOS bundle ID / Android package).
EXPO_PUBLIC_APPWRITE_PLATFORM=com.hyperter96.nodelearn
# TablesDB database id (Realtime channel names); matches backend APPWRITE_DATABASE_ID.
EXPO_PUBLIC_APPWRITE_DATABASE_ID=main

# --- BFF (Hono) -----------------------------------------------------------------
# Local backend runs on 8070 (no trailing slash)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8070
# Set to 1 to use the in-memory mock API instead of the real backend
EXPO_PUBLIC_API_MOCK=0

# --- Web ------------------------------------------------------------------------
# Public web origin; Expo web dev server runs on 8071. Used for OAuth return and
# password-reset / email-verification redirect links.
EXPO_PUBLIC_WEB_URL=http://localhost:8071

# Deployed Appwrite Function (npm run deploy:api). Set EXPO_PUBLIC_API_BASE_URL to this for staging/prod web builds.
# EXPO_PUBLIC_API_BASE_URL=https://6ab25202000c575857b2.appwrite.network
